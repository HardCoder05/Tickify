{
  "name": "tickify-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npx vite",
    "build": "npx tsc -b && npx vite build",
    "lint": "eslint .",
    "preview": "npx vite preview",
    "test": "cd ../../Tests && npx playwright test",
    "test:e2e": "cd ../../Tests && npx playwright test E2E",
    "test:e2e:headed": "cd ../../Tests && npx playwright test E2E --headed",
    "test:e2e:ui": "cd ../../Tests && npx playwright test E2E --ui",
    "test:e2e:auth": "cd ../../Tests && npx playwright test E2E/auth",
    "test:e2e:events": "cd ../../Tests && npx playwright test E2E/events",
    "test:e2e:tickets": "cd ../../Tests && npx playwright test E2E/tickets",
    "test:e2e:purchases": "cd ../../Tests && npx playwright test E2E/purchases",
    "test:e2e:admin": "cd ../../Tests && npx playwright test E2E/admin",
    "test:e2e:antitest": "cd ../../Tests && npx playwright test E2E/antitest",
    "test:e2e:antitest:headed": "cd ../../Tests && npx playwright test E2E/antitest --headed",
    "test:e2e:report": "cd ../../Tests && npx playwright show-report",
    "test:e2e:debug": "cd ../../Tests && npx playwright test E2E --debug",
    "test:e2e:ci": "cd ../../Tests && npx playwright test E2E --workers=1 --project=chromium --reporter=html,json",
    "test:e2e:critical": "cd ../../Tests && npx playwright test E2E/auth E2E/purchases --workers=1 --project=chromium",
    "test:e2e:smoke": "cd ../../Tests && npx playwright test Frontend/smoke --workers=1 --project=chromium",
    "test:e2e:smoke:ui": "cd ../../Tests && npx playwright test Frontend/smoke --ui",
    "test:e2e:watch": "cd ../../Tests && npx playwright test E2E --watch",
    "test:e2e:cleanup": "cd ../../Tests && python Backend/seed_e2e_data.py"
  },
  "dependencies": {
    "@babel/runtime": "^7.27.6",
    "fflate": "^0.8.2",
    "@fontsource-variable/manrope": "^5.2.8",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@tailwindcss/vite": "^4.1.13",
    "axios": "^1.12.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "flowbite-react": "^0.12.10",
    "jspdf": "^3.0.4",
    "jspdf-autotable": "^5.0.2",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-icons": "^5.5.0",
    "react-is": "^19.1.0",
    "react-router": "^7.9.3",
    "react-router-dom": "^7.9.3",
    "recharts": "^3.3.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.7"
  }
}